# ==============================================================================
# Workout Diary Mobile (FitLog) — Environment Variables
# Copy this file to .env or .env.local inside the `mobile/` directory
#
# IMPORTANT:
# - Use ONLY public anonymous credentials (EXPO_PUBLIC_*)
# - NEVER put service_role or database passwords in this file!
# ==============================================================================

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous API Key (Project Settings -> API -> Project API keys -> anon public)
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
